# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_SECRET=random_secure_hex_32_characters_here

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=upi_checkout
DB_USER=upi_user
DB_PASS=your_strong_mysql_password
DB_CHARSET=utf8mb4

# Merchant & UPI Settings
UPI_VPA=payee@upi
MERCHANT_NAME="Exclusive Content Hub"
PAYMENT_TIMEOUT_MINUTES=30

# Webhook & Gateway Secrets
WEBHOOK_SECRET=your_gateway_webhook_secret_key_here
PROVIDER_ADAPTER=upi_direct
# Options: upi_direct, razorpay, phonepe_pg, cashfree

# Storage Settings
STORAGE_PATH=/storage/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
