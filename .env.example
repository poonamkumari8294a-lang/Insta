# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin Authentication Secret (Used for logging in to /admin)
ADMIN_SECRET_KEY="Ashok#8899"

# Creator Payment Configuration
CREATOR_UPI_ID="ashokjee62022.wallet@phonepe"
CREATOR_NAME="Ruma Kumari"

# Cloudinary Media Storage (Unsigned Browser Uploads)
VITE_CLOUDINARY_CLOUD_NAME="mnbjgtqu"
VITE_CLOUDINARY_UPLOAD_PRESET="rumacutegirl"

# Server-Side Cloudinary Admin Deletion Credentials (Never exposed to browser)
CLOUDINARY_CLOUD_NAME="mnbjgtqu"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment Gateway Provider Mode: "sandbox_simulator" | "phonepe_pg" | "razorpay" | "live_merchant"
PAYMENT_GATEWAY_MODE="sandbox_simulator"
WEBHOOK_SECRET="whsec_ruma_creator_secret_key_8849"
